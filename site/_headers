# Cloudflare Pages response headers (SPEC 5.9). Deployed from the site/ folder; see SETUP.md.
# Format: a path pattern, then indented "Name: value" lines. Lines starting with # are comments.
# Don't set Cache-Control in the /* block: Cloudflare joins a header that matches two rules with a comma.
# HTML pages and the root files (config.js, favicon.svg, site.webmanifest, robots.txt, sitemap.xml) keep Cloudflare's
# default, which revalidates on every visit, so edits to config.js and the pages show up immediately.

# X-Frame-Options: nothing frames this site (Gumroad's checkout is a frame of gumroad.com inside our pages, not the
# other way round), so no other site may put the Studio or the pages in a frame.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Libraries carry their version in the file name, so they never change in place.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# The font files never change. If you ever replace them, give the new files new names.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Code, styles and the data modules (word lists, picture library, blocklist) have no version in their names, and the
# browser loads them as one set of ES modules. If any of them could be served from cache after a deploy, a returning
# visitor would get old and new files mixed, and the Studio would fail to start (a normal reload doesn't fix that).
# So the browser checks each one on every visit: Cloudflare answers with a small "304 Not Modified" when nothing
# changed. Don't raise these values unless the file names carry a version, like /vendor/*.
/data/*
  Cache-Control: public, max-age=0, must-revalidate

/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Sample PDFs, social preview images, icons and gallery images. Re-generated rarely (see SETUP.md, step 6).
/samples/*
  Cache-Control: public, max-age=86400

/og/*
  Cache-Control: public, max-age=86400

/img/*
  Cache-Control: public, max-age=86400

# Content-Security-Policy: deliberately NOT enabled. It is optional and must only be turned on after testing that
# Gumroad's checkout overlay still works (SPEC 5.9). To try it, add the line below (without the leading "# ", on one
# line) to the /* block above, deploy to a preview branch first, and test: the buy buttons and the checkout overlay,
# license activation, PDF/PNG/ZIP export, the nonogram picture upload and Web Analytics. Remove it if anything breaks.
# Gumroad's overlay loads https://gumroad.com/js/gumroad.js, which pulls scripts, styles, fonts and images from
# https://assets.gumroad.com, so keep every assets.gumroad.com entry. 'unsafe-inline' in style-src is only needed so
# the gallery SVGs (/img/gallery/*.svg) keep their font when opened on their own; the pages work without it.
# This policy was tested against every flow listed above, the Polar activation and the Cloudflare beacon, with no
# violations. Use this one, not the shorter example in docs/SPEC.md 5.9, which would break the overlay.
# The 'sha256-…' source allows the Studio's small inline boot watchdog (site/app/index.html); npm test checks that it
# matches the script, so after editing that script, put the new hash here (the failing test prints it).
#   Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-vkAajViz88Bk/Ahadsjh7uHUJ+4s8I3TQZHY8GS7l1U=' https://gumroad.com https://assets.gumroad.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://assets.gumroad.com; img-src 'self' data: blob: https://assets.gumroad.com; font-src 'self' https://assets.gumroad.com; connect-src 'self' https://api.gumroad.com https://api.polar.sh https://cloudflareinsights.com; frame-src https://gumroad.com https://*.gumroad.com; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
# Once HTTPS works on your own domain (SETUP.md step 5), you can also add to the /* block:
